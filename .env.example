# Application ports and hosts
FRONTEND_PORT=5000                       # example: 5000
BACKEND_HOST=backend                     # example: backend
BACKEND_PORT=8000                        # example: 8000
BACKEND_API_URL=http://${BACKEND_HOST}:${BACKEND_PORT}

# Redis configuration
REDIS_URL_CONSTRAINTS=redis://redis:6379     # example: redis://<host>:6379
REDIS_URL_MEMORIES=redis://redis:6379        # example: redis://<host>:6379
REDIS_INDEX_CONSTRAINTS=idx:doc_vss          # example: idx:doc_vss

# Ollama settings
OLLAMA_PORT=7689
OLLAMA_HOST=192.168.91.15:${OLLAMA_PORT}     # example: <host>:${OLLAMA_PORT}
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=24h
OLLAMA_ORIGINS=*

# Model configuration
SMALL_REASONING_MODEL=your-small-model-name      # example: qwen3:1.7b
REASONING_MODEL=your-reasoning-model-name        # example: qwen3:8b
STANDARD_MODEL=your-standard-model-name          # example: llama3.2:3b

EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_MODEL_EMBEDDING_DIMS=768

OLLAMA_MODEL_LLM_ROUTING=${SMALL_REASONING_MODEL}
OLLAMA_MODEL_LLM_PROCESSING=${SMALL_REASONING_MODEL}
OLLAMA_MODEL_LLM_TOOLS=${STANDARD_MODEL}
OLLAMA_MODEL_LLM_ANSWERING=${REASONING_MODEL}
OLLAMA_MODEL_LLM_BENCHMARKING=${REASONING_MODEL}

OLLAMA_MODEL_EMBEDDING=${EMBEDDING_MODEL}
